# arbstr node environment variables
# Copy to .env and fill in values: cp .env.example .env
# Generate each secret with: openssl rand -hex 32

# Vault operator admin token (min 32 chars, required)
VAULT_ADMIN_TOKEN=change-me-to-a-random-admin-secret

# Vault internal API shared secret (shared between core and vault, min 32 chars)
VAULT_INTERNAL_TOKEN=change-me-to-a-random-internal-secret

# Cashu mint private key — this placeholder is insecure; set your own
MINT_PRIVATE_KEY=supersecretprivatekey

# Vault payment rail: simulated (default, no real funds), lightning, cashu, or auto
# WALLET_BACKEND=simulated

# Cashu payment rail threshold in millisatoshis (default: 1M msats = 1000 sats)
# Below threshold: Cashu (instant, zero fees). Above: Lightning (final settlement).
CASHU_THRESHOLD_MSAT=1000000

# LND credentials for vault (base64-encoded; required when WALLET_BACKEND is lightning or auto)
# LND_CERT_BASE64=
# LND_MACAROON_BASE64=

# Logging level for arbstr core
RUST_LOG=arbstr=info

# Provider keys referenced from config.toml (passed into the core container for ${VAR} expansion)
# ARBSTR_ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ROUTSTR_API_KEY=
